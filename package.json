{
  "name": "janartys-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "test": "node --test test/smoke.test.js test/presentation.test.js test/customer.test.js && npm run test:manager && npm run test:instagram",
    "test:instagram": "node --test test/instagram.test.js test/instagram-connect.test.js instagram-feed/test/*.test.js",
    "test:manager": "node --experimental-vm-modules --test test/manager.test.js test/catalog-case.test.js test/hours-about.test.js",
    "test:relay": "npm --prefix push-relay test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-janartys-rules \"node --test test/firestore-rules.test.js\"",
    "ios:enable-push": "node scripts/enable-ios-push.mjs",
    "test:ui": "node --test test/ui.test.js"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@firebase/rules-unit-testing": "5.0.0",
    "axe-core": "4.10.3",
    "firebase-tools": "15.34.0",
    "playwright": "1.64.1",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.5.1",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "firebase": "^12.18.0"
  }
}
