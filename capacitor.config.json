{
  "appId": "com.janartys.app",
  "appName": "Janarty's",
  "webDir": "dist",
  "includePlugins": ["@capacitor/haptics", "@capacitor/splash-screen", "@capacitor/status-bar"],
  "experimental": { "ios": { "spm": { "packageOptions": { "@capacitor-firebase/messaging": { "symlink": true } } } } },
  "backgroundColor": "#000000",
  "server": { "androidScheme": "https" },
  "ios": { "contentInset": "never", "preferredContentMode": "mobile" },
  "plugins": {
    "FirebaseMessaging": { "presentationOptions": ["alert", "sound"] },
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#000000",
      "showSpinner": false
    },
    "StatusBar": { "style": "DARK", "backgroundColor": "#000000" }
  }
}
