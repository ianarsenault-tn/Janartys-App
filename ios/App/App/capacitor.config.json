{
	"appId": "com.janartys.app",
	"appName": "Janarty's",
	"webDir": "dist",
	"includePlugins": [
		"@capacitor/haptics",
		"@capacitor/splash-screen",
		"@capacitor/status-bar"
	],
	"experimental": {
		"ios": {
			"spm": {
				"packageOptions": {
					"@capacitor-firebase/messaging": {
						"symlink": true
					}
				}
			}
		}
	},
	"backgroundColor": "#FFF8F0",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"contentInset": "never",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"FirebaseMessaging": {
			"presentationOptions": [
				"alert",
				"sound"
			]
		},
		"SplashScreen": {
			"launchShowDuration": 0,
			"backgroundColor": "#FFF8F0",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#FFF8F0"
		}
	},
	"packageClassList": [
		"HapticsPlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
