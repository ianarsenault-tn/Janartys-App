{
	"appId": "com.janartys.app",
	"appName": "Janarty's",
	"webDir": "dist",
	"backgroundColor": "#000000",
	"server": {
		"androidScheme": "https"
	},
	"ios": {
		"contentInset": "never",
		"preferredContentMode": "mobile"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 0,
			"backgroundColor": "#000000",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#000000"
		}
	},
	"packageClassList": [
		"SplashScreenPlugin",
		"StatusBarPlugin"
	]
}
