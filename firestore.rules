rules_version = "2";
service cloud.firestore {
  match /databases/{database}/documents {
    // Authorize the existing accounts, not anyone claiming a staff email.
    // Recreated accounts receive new UIDs and require explicit approval here.
    // Keep pairs aligned with push-relay/src/staff-identities.js; npm test checks parity.
    function isStaff() {
      return request.auth != null && (
        (request.auth.uid == "KcRs37Q7yVbLiZNuk2m0q0Rqjx72"
          && request.auth.token.email == "ian.arsenault@yahoo.com")
        || (request.auth.uid == "7a7vnB6g64Yxnp1pXROYYOUoKzz2"
          && request.auth.token.email == "janartys@gmail.com")
      );
    }

    function isCaseId(id) {
      return id is string && id.size() > 0;
    }

    function isInstagram(ig) {
      // Null uses the default card. Older maps can omit text/timestamp fields.
      return ig == null || (ig is map
        && ig.get("imageUrl", "") is string
        && ig.get("caption", "") is string
        && ig.get("permalink", "") is string
        && ig.get("handle", "") is string
        && ig.get("updatedAt", 0) is number);
    }

    function isNotice(notice) {
      return notice == null || (notice is map
        && notice.get("message", "") is string
        && notice.get("message", "").size() <= 100);
    }

    function isHoursOverride(hours) {
      // Closed days and legacy overrides may omit opening/closing details.
      return hours == null || (hours is map
        && hours.get("date", "") is string
        && hours.get("closed", false) is bool
        && hours.get("open", "") is string
        && hours.get("close", "") is string
        && hours.get("mode", "") is string);
    }

    // Validate the resulting document, including after partial staff updates.
    // Catalog entries stay compatible with sparse legacy records. Rules have no
    // generic list-element validator; do not claim exhaustive catalog validation.
    function isLiveShape() {
      let d = request.resource.data;
      return d.keys().hasAll([
          "catalog", "caseIds", "updatedAt", "lastSwap",
          "lastNotice", "hoursOverride", "instagram"
        ])
        && d.catalog is list
        && d.caseIds is list
        && d.caseIds.size() == 8
        && isCaseId(d.caseIds[0]) && isCaseId(d.caseIds[1])
        && isCaseId(d.caseIds[2]) && isCaseId(d.caseIds[3])
        && isCaseId(d.caseIds[4]) && isCaseId(d.caseIds[5])
        && isCaseId(d.caseIds[6]) && isCaseId(d.caseIds[7])
        && isInstagram(d.instagram)
        && isNotice(d.lastNotice)
        && isHoursOverride(d.hoursOverride)
        && d.updatedAt is number
        && d.catalog.size() <= 500;
    }

    match /shop/live {
      allow read: if true;
      allow create, update: if isStaff() && isLiveShape();
      allow delete: if false;
    }
    // Every other document and subcollection is denied by default.
  }
}
